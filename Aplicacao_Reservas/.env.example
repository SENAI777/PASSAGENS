# Modelo de configuração.
# Copie este arquivo para ".env" e preencha com os dados do seu PC:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/Mac)
# O arquivo .env NÃO deve ir para o Git (já está no .gitignore).

# Porta da aplicação
PORT=8080

# Banco de dados MySQL
# O banco PASSAGENS e as tabelas são criados sozinhos ao iniciar (Flyway).
DB_URL=jdbc:mysql://localhost:3306/PASSAGENS?createDatabaseIfNotExist=true
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql

# E-mail de confirmação das reservas
# Gmail: ative a verificação em 2 etapas e gere uma "Senha de app"
# (Conta Google > Segurança > Senhas de app). Deixe em branco para não enviar.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app
